{
  "schemaVersion": 1,
  "name": "plugin-preview-text",
  "version": "0.2.0",
  "displayName": "文本预览",
  "description": "预览选中文件的文本内容，可设置自动读取与显示字数。",
  "author": "base",
  "minHostVersion": "0.1.0",
  "frontend": {
    "entry": "frontend/dist/index.js",
    "slots": [
      { "id": "preview-zone", "export": "TextPreview" },
      { "id": "settings-page:preview-text", "export": "SettingsPage", "label": "文本预览" }
    ]
  },
  "permissions": {
    "capabilities": ["fs.readText"],
    "events": {
      "subscribe": [],
      "emit": []
    },
    "slots": { "contribute": ["preview-zone", "settings-page:preview-text"] }
  }
}
