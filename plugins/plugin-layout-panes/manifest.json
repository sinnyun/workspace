{
  "schemaVersion": 1,
  "name": "plugin-layout-panes",
  "version": "0.1.0",
  "displayName": "分栏容器",
  "description": "C 主视图的分栏容器：单栏 / 左右双栏 / 2×2 四栏，提供嵌套槽 pane-slot:<n>（docs/08 §5.1）",
  "author": "base",
  "minHostVersion": "0.1.0",
  "frontend": {
    "entry": "frontend/dist/index.js",
    "slots": [{ "id": "main-view-zone", "export": "PanesContainer" }],
    "provides": ["pane-slot"]
  },
  "permissions": {
    "capabilities": [],
    "events": {
      "subscribe": [],
      "emit": ["slot:reconfigured"]
    },
    "slots": {
      "contribute": ["main-view-zone"]
    }
  }
}
