{
  "schemaVersion": 1,
  "name": "plugin-layout-views",
  "version": "0.1.0",
  "displayName": "侧栏视图容器",
  "description": "B 侧栏的互斥容器：占用 nav-zone，按 activeSidebarView 只呈现一个视图面板，提供嵌套槽 nav-panel:<viewId>",
  "author": "base",
  "minHostVersion": "0.1.0",
  "frontend": {
    "entry": "frontend/dist/index.js",
    "slots": [{ "id": "nav-zone", "export": "ViewsContainer" }],
    "provides": ["nav-panel"]
  },
  "permissions": {
    "capabilities": [],
    "events": {
      "subscribe": [],
      "emit": []
    },
    "slots": {
      "contribute": ["nav-zone"]
    }
  }
}
