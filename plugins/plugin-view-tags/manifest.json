{
  "schemaVersion": 1,
  "name": "plugin-view-tags",
  "version": "0.1.0",
  "displayName": "标签视图",
  "description": "侧栏视图：A 图标 + B 标签面板；给焦点对象打标签、点标签发 sidebar:selection:changed、点其内文件发 focus:changed",
  "author": "base",
  "minHostVersion": "0.1.0",
  "frontend": {
    "entry": "frontend/dist/index.js",
    "slots": [
      { "id": "activity-rail-zone", "export": "RailIcon" },
      { "id": "nav-panel:tags", "export": "TagsPanel" }
    ]
  },
  "permissions": {
    "capabilities": [],
    "events": {
      "subscribe": [],
      "emit": ["sidebar:view:changed", "sidebar:selection:changed", "focus:changed"]
    },
    "slots": {
      "contribute": ["activity-rail-zone", "nav-panel:tags"]
    }
  }
}
