{
  "schemaVersion": 1,
  "name": "plugin-file-browser",
  "version": "0.4.0",
  "displayName": "文件浏览",
  "description": "浏览文件夹，切换列表、网格或表格，查看图片缩略图与关联标签；可设置默认视图、表格列与缩略图显示。",
  "author": "base",
  "minHostVersion": "0.1.0",
  "frontend": {
    "entry": "frontend/dist/index.js",
    "slots": [
      {
        "id": "topbar-zone",
        "export": "FileBrowserToolbar"
      },
      {
        "id": "settings-page:file-browser",
        "export": "SettingsPage",
        "label": "文件浏览"
      }
    ],
    "provides": []
  },
  "permissions": {
    "capabilities": [
      "fs.home",
      "fs.list",
      "shell.thumbnail.read",
      "db.tags.list"
    ],
    "events": {
      "subscribe": [
        "sidebar:selection:changed",
        "slot:registered",
        "slot:disposed",
        "file:changed",
        "tags:updated"
      ],
      "emit": [
        "focus:changed"
      ]
    },
    "slots": {
      "contribute": [
        "pane-slot:*",
        "settings-page:file-browser",
        "topbar-zone"
      ]
    },
    "contextMenu": {
      "contribute": true,
      "open": [
        "browser.list.item",
        "browser.grid.item",
        "browser.empty"
      ]
    }
  }
}
