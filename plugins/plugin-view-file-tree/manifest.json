{
  "schemaVersion": 1,
  "name": "plugin-view-file-tree",
  "version": "0.1.0",
  "displayName": "目录树视图",
  "description": "以目录树浏览文件夹，按需展开子目录。",
  "author": "base",
  "minHostVersion": "0.1.0",
  "frontend": {
    "entry": "frontend/dist/index.js",
    "slots": [
      { "id": "activity-rail-zone", "export": "RailIcon" },
      { "id": "nav-panel:file-tree", "export": "TreePanel" }
    ]
  },
  "permissions": {
    "capabilities": ["fs.home", "fs.list"],
    "events": {
      "subscribe": [],
      "emit": ["sidebar:view:changed", "sidebar:selection:changed"]
    },
    "slots": {
      "contribute": ["activity-rail-zone", "nav-panel:file-tree"]
    }
  }
}
